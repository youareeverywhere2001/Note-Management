# Sao chép thành .env rồi sửa. File .env KHÔNG được đưa lên Git / chia sẻ.
# Docker: docker-compose.yml tự đặt DB_*, SMTP_*; bạn chỉ cần WS_SECRET và GEMINI_API_KEY ở đây.
# XAMPP:  PHP và Node đều đọc file này.

# ---------- Cơ sở dữ liệu (CHỈ dùng khi chạy XAMPP; Docker bỏ qua phần này) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=note_management
DB_USER=root
DB_PASS=

# ---------- Địa chỉ website (dùng trong link email) ----------
# XAMPP:  http://localhost/Note-Management/public     Docker: để trống hoặc http://localhost:8080
APP_URL=

# ---------- Email ----------
# MAIL_DRIVER=log : không gửi email, ghi vào storage/mail/mail.log (link kích hoạt / OTP nằm trong đó) — tiện khi chạy XAMPP
# MAIL_DRIVER=smtp: gửi qua SMTP (cần chạy "composer install" để có PHPMailer)
MAIL_DRIVER=log
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@noteapp.local

# ---------- WebSocket (cộng tác thời gian thực) ----------
# Chuỗi bí mật dùng chung giữa PHP và máy chủ Node. Tạo bằng:  openssl rand -hex 32
WS_SECRET=
WS_PORT=8081
# Địa chỉ WebSocket mà TRÌNH DUYỆT dùng
WS_PUBLIC_URL=ws://localhost:8081
# Địa chỉ PHP mà máy chủ Node gọi (nội bộ). XAMPP: thư mục public của dự án
PHP_INTERNAL_URL=http://localhost/Note-Management/public
# (Tùy chọn) chỉ cho phép các origin này kết nối WebSocket, cách nhau bằng dấu phẩy
WS_ALLOWED_ORIGINS=http://localhost

# ---------- AI (Gemini) — khóa chỉ nằm ở máy chủ, không bao giờ gửi xuống trình duyệt ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
